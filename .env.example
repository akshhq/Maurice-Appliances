# ==============================================================================
# MAURICE APPLIANCES — ENVIRONMENT & BACKEND CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.

# ------------------------------------------------------------------------------
# 1. GOOGLE SHEETS & APPS SCRIPT CONFIGURATION
# ------------------------------------------------------------------------------
# Google Spreadsheet ID (from your sheet URL: https://docs.google.com/spreadsheets/d/[ID]/edit)
GOOGLE_SHEET_ID="YOUR_GOOGLE_SPREADSHEET_ID_HERE"

# Google Apps Script Web App Deployment URL (ends in /exec)
GOOGLE_SCRIPT_WEBAPP_URL="YOUR_GOOGLE_APPS_SCRIPT_WEBAPP_URL_HERE"

# ------------------------------------------------------------------------------
# 2. HOSTINGER SMTP & EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl

SMTP_USERNAME=customer.care@mauriceappliances.in
SMTP_PASSWORD=PUT_YOUR_MAILBOX_PASSWORD_HERE

FROM_EMAIL=customer.care@mauriceappliances.in
FROM_NAME="Maurice Appliances Website"

TO_EMAIL=customer.care@mauriceappliances.in
TO_NAME="Maurice Appliances"

# ==============================================================================
# 3. GOOGLE APPS SCRIPT CODE (Paste into Extensions > Apps Script in Google Sheets)
# ==============================================================================
# The complete Google Apps Script code is in: google-script/Code.gs
