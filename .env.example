# ============================================================
#  MAURICE APPLIANCES — LIVE SETTINGS
#  Edit APP_URL below to your domain. That is the only required change.
# ============================================================

# ---------- YOUR WEBSITE ADDRESS ----------
# Leave EMPTY and the site auto-detects your address — it will work
# straight away on your domain or a temporary Hostinger URL.
# Only fill this in once your final domain is live, e.g.
#   APP_URL=https://www.mauriceappliances.in
APP_URL=

# ---------- Application ----------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# ---------- Where contact form messages are sent ----------
MAIL_TO_ENQUIRIES=mauriceappliances@gmail.com
MAIL_TO_DEALERS=mauriceappliances@gmail.com
MAIL_TO_CAREERS=mauriceappliances@gmail.com

# ---------- Mail sending ----------
# "mail" uses the server's built-in mail. If messages don't arrive,
# create a mailbox in hPanel > Emails and switch to smtp below.
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=noreply@mauriceappliances.in
MAIL_FROM_NAME="Maurice Appliances"

# SMTP (only needed if MAIL_DRIVER=smtp)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ---------- Data ----------
DB_CONNECTION=json

# ---------- Cache ----------
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_TTL=3600
