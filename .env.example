# ==============================================================================
# MAURICE APPLIANCES — HOSTINGER SMTP & EMAIL CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual Hostinger mailbox credentials.
# NEVER commit the .env file containing real passwords to public repositories.

# Hostinger SMTP Server Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl

# Mailbox Authentication Credentials
SMTP_USERNAME=customer.care@mauriceappliances.in
SMTP_PASSWORD=PUT_YOUR_MAILBOX_PASSWORD_HERE

# Sender Information (Displayed as "From" in incoming emails)
FROM_EMAIL=customer.care@mauriceappliances.in
FROM_NAME="Maurice Appliances Website"

# Destination Mailbox (Where all form submissions will be received)
TO_EMAIL=customer.care@mauriceappliances.in
TO_NAME="Maurice Appliances"
