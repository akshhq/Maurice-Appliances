# ==============================================================================
# MAURICE APPLIANCES — ENVIRONMENT & BACKEND CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# WARNING: NEVER commit the actual .env file with production credentials to git.

# ------------------------------------------------------------------------------
# 1. GOOGLE SHEETS & APPS SCRIPT CONFIGURATION
# ------------------------------------------------------------------------------
# Google Spreadsheet ID (from your Google Sheet URL: https://docs.google.com/spreadsheets/d/[ID]/edit)
GOOGLE_SHEET_ID="YOUR_GOOGLE_SPREADSHEET_ID_HERE"

# Google Apps Script Web App Deployment URL (ends in /exec)
# Follow the deployment instructions in form_todo.md and google-apps-script.js
GOOGLE_SCRIPT_WEBAPP_URL="YOUR_GOOGLE_APPS_SCRIPT_WEBAPP_URL_HERE"

# ------------------------------------------------------------------------------
# 2. HOSTINGER SMTP & EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Hostinger SMTP Server Configuration
# Recommended: Port 465 with SSL (or Port 587 with TLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURITY="ssl"

# Mailbox Authentication Credentials (from Hostinger Webmail)
SMTP_USERNAME="customer.care@mauriceappliances.in"
SMTP_PASSWORD="PUT_YOUR_MAILBOX_PASSWORD_HERE"

# Sender Information (Displayed as "From" header in incoming emails)
FROM_EMAIL="customer.care@mauriceappliances.in"
FROM_NAME="Maurice Appliances Website"

# Destination Mailbox (Where all form submissions will be delivered)
TO_EMAIL="customer.care@mauriceappliances.in"
TO_NAME="Maurice Appliances"

# ------------------------------------------------------------------------------
# 3. REFERENCES & DOCUMENTATION
# ------------------------------------------------------------------------------
# - Complete Google Apps Script: google-apps-script.js
# - Step-by-Step Setup Guide & Checklist: form_todo.md
# - PHP Backend Handler: api/submit-form.php & api/config.php
