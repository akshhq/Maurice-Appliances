# ============================================================
#  MAURICE APPLIANCES — .htaccess
#  Upload the contents of this package directly into public_html.
#  Apache / Hostinger shared hosting, PHP 8.x
# ============================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8
ServerSignature Off

RewriteEngine On

# ------------------------------------------------------------
#  1. BLOCK APPLICATION FOLDERS
#  In this layout the application lives inside the web root, so
#  these folders MUST be blocked explicitly. Each also carries its
#  own deny-all .htaccess as a second line of defence.
# ------------------------------------------------------------
RewriteRule ^(app|config|includes|database|storage|logs|cache|tmp|backups|scripts|tests|docs|integrations|cron|vendor|admin|auth|dashboard|portal)(/|$) - [F,L]

# View folders are include-only and must never be requested directly
RewriteRule ^(components|layouts|sections|partials|templates)(/|$) - [F,L]

# ------------------------------------------------------------
#  2. BLOCK SENSITIVE FILES
# ------------------------------------------------------------
<FilesMatch "^\.(env|git|htaccess|htpasswd|DS_Store|gitignore)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(json|md|lock|sql|log|ini|yml|yaml|bak|sh|dist|example)$">
  Require all denied
</FilesMatch>

# …but these public files must stay reachable
<Files "manifest.json">
  Require all granted
</Files>
<Files "browserconfig.xml">
  Require all granted
</Files>

# ------------------------------------------------------------
#  3. HTTPS  (uncomment once your SSL certificate is active)
# ------------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------
#  4. CANONICAL HOST  (pick ONE, then uncomment)
# ------------------------------------------------------------
# Force www:
# RewriteCond %{HTTP_HOST} ^mauriceappliances\.in$ [NC]
# RewriteRule ^(.*)$ https://www.mauriceappliances.in/$1 [R=301,L]
#
# Force non-www:
# RewriteCond %{HTTP_HOST} ^www\.mauriceappliances\.in$ [NC]
# RewriteRule ^(.*)$ https://mauriceappliances.in/$1 [R=301,L]

# ------------------------------------------------------------
#  5. CLEAN URLs  (optional — /products instead of /products.php)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Serve the dynamic sitemap at /sitemap.xml when no static file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ------------------------------------------------------------
#  6. ERROR DOCUMENTS
# ------------------------------------------------------------
ErrorDocument 400 /errors/400.php
ErrorDocument 401 /errors/401.php
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php

# ------------------------------------------------------------
#  7. COMPRESSION
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  8. CACHING
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ---------- Security headers ----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# ------------------------------------------------------------
#  9. UPLOADS — never execute code from this directory
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.(php|phtml|phar|cgi|pl)$ - [F,L]
</IfModule>
