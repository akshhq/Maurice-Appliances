# Deny all direct web access to this application directory.
# This folder sits inside the web root in this deployment package,
# so this rule is load-bearing — do not remove it.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
